SELECT
O.ORDERID,
C.CUSTOMERNAME,
C.CITY,
O.ORDERDATE,
O.STATUS
FROM ORDERS O
INNER JOIN CUSTOMERS C
ON O.CUSTOMERID=C.CUSTOMERS

SELECT C.CUSTOMERNAME,
C.CITY,
SUM(OD.QUANTITY * OD.UNITPRICE) AS TOTALSPENT
FROM CUSTOMERS C
INNER JOIN ORDERS O
ON C.CUSTOMERID=O.CUSTOMERID
INNER JOIN ORDERDETAILS OD
ON O.ORDERID=OD.ORDERID
GROUP BY 
C.CUSTOMERID,
C.CUSTOMERNAME,
C.CITY
ORDER BY TOTALSPENT DESC

SELECT YEAR(O.ORDERDATE) AS SALESYEAR,
MONTH(O.ORDERDATE) AS SALESMONTH,
SUM(OD.QUANTITY * OD.UNITPRICE) AS TOTALSALES
FROM ORDERS O
INNER JOIN ORDERDETAILS OD
ON O.ORDERID=OD.ORDERID
GROUP BY 
YEAR(O.ORDERDATE),
MONTH(O.ORDERDATE)
ORDER BY
SALESYEAR,
SALESMONTH

SELECT P.PRODUCTNAME,
SUM(OD.QUANTITY * OD.UNITPRICE) AS TOTALSALES,
CASE
 WHEN SUM(OD.QUANTITY * OD.UNITPRICE)>=20000
  THEN 'HIGH SALES'
 WHEN SUM(OD.QUANTITY * OD.UNITPRICE)>=3000
  THEN 'MEDIUM SALES'
 ELSE 'LOW SALES'
END AS SALESCATEGORY
FROM PRODUCTS P
INNER JOIN ORDERDETAILS OD
ON P.PRODUCTID=OD.PRODUCTID
GROUP BY 
P.PRODUCTID,
P.PRODUCTNAME
ORDER BY TOTALSALES DESC

WITH PRODUCTSALES AS(
SELECT P.PRODUCTID,
P.PRODUCTNAME,
SUM(OD.QUANTITY * OD.UNITPRICE) AS TOTALSALES
FROM PRODUCTS P
INNER JOIN ORDERDETAILS OD
ON P.PRODUCTID=OD.PRODUCTID
GROUP BY 
P.PRODUCTID,
P.PRODUCTNAME)
SELECT
PRODUCTNAME,
TOTALSALES FROM PRODUCTSALES
WHERE TOTALSALES>
(SELECT AVG(TOTALSALES)
FROM PRODUCTSALES)
ORDER BY TOTALSALES DESC

WITH PRODUCTSALES AS(
SELECT P.PRODUCTID,
P.PRODUCTNAME,
SUM(OD.QUANTITY * OD.UNITPRICE) AS TOTALSALES
FROM PRODUCTS P
INNER JOIN ORDERDETAILS OD
ON P.PRODUCTID=OD.PRODUCTID
GROUP BY
P.PRODUCTID,
P.PRODUCTNAME)
SELECT PRODUCTNAME,TOTALSALES,
RANK() OVER(
ORDER BY TOTALSALES DESC) AS SALESRNK
FROM PRODUCTSALES

SELECT SUM(QUANTITY * UNITPRICE) AS TOTALREVENUE
FROM ORDERDETAILS

SELECT O.STATUS,
SUM(OD.QUANTITY * OD.UNITPRICE) AS STATUSREVENUE
FROM ORDERS O
INNER JOIN ORDERDETAILS OD
ON O.ORDERID=OD.ORDERID
GROUP BY O.STATUS
ORDER BY STATUSREVENUE DESC

WITH OVERALLSALES AS(
SELECT SUM(QUANTITY * UNITPRICE) AS TOTALREVENUE
FROM ORDERDETAILS),
STATUSSALES AS(
SELECT
SUM(OD.QUANTITY * OD.UNITPRICE) AS STATUSREVENUE
FROM ORDERS O
INNER JOIN ORDERDETAILS OD
ON O.ORDERID=OD.ORDERID
)
SELECT TOTALREVENUE,
STATUSREVENUE,
CASE
 WHEN TOTALREVENUE=STATUSREVENUE
  THEN 'PASS'
 ELSE 'CHECK REQUIRED'
END AS VALIDATIONRESULT
FROM OVERALLSALES 
CROSS JOIN STATUSSALES




